# Copy to .env.local. Blank = not set. The app refuses to start if anything required is missing.

# mock (default, no broker) | demo | live. Live also needs accounts.live_enabled=true in the DB.
TRADING_MODE=mock
# 1 = kill switch on: blocks everything except close-all-now.
TRADING_HALTED=0
LOG_LEVEL=info

# Required for demo/live. MT5 login/password live in MetaApi only, never here.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=

# Required for demo/live. 32+ random chars: openssl rand -base64 48
SESSION_SECRET=
# Required for demo/live; must be https in live.
APP_ORIGIN=

# Phase 05
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Caps per action (R5.2, OD7)
MAX_ORDERS_PER_ACTION=100
MAX_TOTAL_LOTS=5
MAX_RISK_PCT_PER_ACTION=2

# Adaptive spread guard (R9.4b): refuse a batch if spread > K x median spread over the window
SPREAD_GUARD_K=3
SPREAD_WINDOW_SEC=300

# Batch identity (R9.1): magic = prefix x 10^9 + batchSeq
APP_MAGIC_PREFIX=7731
